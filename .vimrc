set nocompatible
set showcmd

set wildmenu
set wildignore=*.o,*~,*.pyc

set number
set relativenumber
set linebreak
set showbreak=+++
set textwidth=100
set showmatch
set visualbell

set cursorline
set laststatus=2
 
set hlsearch
set smartcase
set ignorecase
set incsearch
 
set autoindent
set shiftwidth=4
set smartindent
set smarttab
set softtabstop=4
 
set ruler
 
set undolevels=1000
set undodir==~/.vim/undo
set backspace=indent,eol,start

colorscheme retrobox
syntax on
